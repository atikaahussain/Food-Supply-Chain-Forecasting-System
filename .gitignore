# --- Virtual Environments ---
# Ignore the environment folders where your libraries are installed
venv/
venvs/
.venv/
env/
# dependencies
node_modules/
/.pnp
.pnp.js

# --- Python & Cache ---
# Ignore compiled files and Jupyter checkpoints
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/
# This covers pycache inside subfolders too
**/__pycache__/
# testing
coverage/

# --- Large Data Files ---
# Ignore the raw Kaggle datasets (they are too big for GitHub)
data/raw/*.csv
# Ignore the processed/cleaned versions
data/processed/*.csv
# Ignore any AI models you save later (.pkl, .h5, .pt)
data/models/
# production
build/
dist/

# --- Environment Secrets ---
# VERY IMPORTANT: This keeps your Neon DB password/URL safe
.env
.flaskenv
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- OS & IDE Files ---
# Ignore VS Code and system-specific files
# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and editor files
.idea/
.vscode/
.DS_Store
*.swp
Thumbs.db

# --- Logs ---
*.log

# Custom ignored directories (e.g., downloaded reports & generated plots)
data/plots/*.png
data/reports/*
!data/reports/.gitkeep